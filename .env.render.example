# Render + Supabase configuration template.
# Put real values in Render Dashboard Environment, never in GitHub.
NODE_ENV=production
PORT=10000
TRUST_PROXY=true
PGSSL=true

# Supabase PostgreSQL connection string from the Connect dialog.
DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Redis-compatible provider URL. Render Key Value or Upstash can be used.
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379

# Generate unique random values for these three secrets.
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_API_KEY=replace_with_a_long_random_admin_key
ACCESS_CODE=replace_with_private_team_access_code_or_bcrypt_hash

# Replace example.com with the final Render hostname or custom domain.
CORS_ORIGIN=https://team-stadium.onrender.com
WEBAUTHN_RP_NAME=Team Stadium
WEBAUTHN_RP_ID=team-stadium.onrender.com
WEBAUTHN_ORIGIN=https://team-stadium.onrender.com
JWT_ISSUER=alpha-team-ptt

SESSION_TTL_SECONDS=86400
ACTIVATION_TTL_SECONDS=600
REDIS_STATUS_TTL_SECONDS=120
PTT_LOCK_TTL_SECONDS=30
WEBRTC_ICE_SERVERS_JSON=[]

SOCKET_CONNECTION_LIMIT=30
SOCKET_EVENT_WINDOW_SECONDS=60
SOCKET_EVENT_LIMIT=180
SOCKET_LOCATION_MIN_INTERVAL_MS=5000
SOCKET_LOCATION_LIMIT=24
SOCKET_INCIDENT_LIMIT=8
SOCKET_SIGNAL_LIMIT=90
SOCKET_PTT_START_LIMIT=24
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT_MAX=20

RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=1000
STORAGE_MONITOR_INTERVAL_SECONDS=21600
STORAGE_WARNING_BYTES=5368709120
AUDIT_RETENTION_DAYS=365
INCIDENT_RETENTION_DAYS=365
LEGACY_INCIDENT_RETENTION_DAYS=180
LOCATION_HISTORY_RETENTION_DAYS=30
WELLBEING_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
SCAN_RETENTION_DAYS=180
ACTIVATION_TOKEN_RETENTION_DAYS=7
PUSH_SUBSCRIPTION_RETENTION_DAYS=180

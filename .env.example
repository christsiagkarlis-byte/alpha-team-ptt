# Non-secret Docker Compose configuration. Do not place secret values in this file.
NODE_ENV=production
PORT=3000
BIND_ADDRESS=127.0.0.1
POSTGRES_DB=alpha_team_ptt
POSTGRES_USER=ptt_app

# Create each file with mode 0600 and one secret value. The Docker image reads them from /run/secrets.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
REDIS_PASSWORD_FILE=./secrets/redis_password
JWT_SECRET_FILE=./secrets/jwt_secret
ADMIN_API_KEY_FILE=./secrets/admin_api_key
ACCESS_CODE_FILE=./secrets/access_code

# Public HTTPS hostname; WebAuthn rejects insecure production origins.
CORS_ORIGIN=https://stadium.example.com
WEBAUTHN_RP_NAME=Team Stadium
WEBAUTHN_RP_ID=stadium.example.com
WEBAUTHN_ORIGIN=https://stadium.example.com
JWT_ISSUER=alpha-team-ptt
SESSION_TTL_SECONDS=86400
ACTIVATION_TTL_SECONDS=600
REDIS_STATUS_TTL_SECONDS=120
PTT_LOCK_TTL_SECONDS=30
TRUST_PROXY=true
PGSSL=false
WEBRTC_ICE_SERVERS_JSON=[]

SOS_ESCALATION_FIRST_SECONDS=30
SOS_ESCALATION_SECOND_SECONDS=120
WELLBEING_STALE_SECONDS=1800

# HTTP / Socket.IO quotas and server-side frequency enforcement.
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT_MAX=20
SOCKET_CONNECTION_LIMIT=30
SOCKET_EVENT_WINDOW_SECONDS=60
SOCKET_EVENT_LIMIT=180
SOCKET_LOCATION_MIN_INTERVAL_MS=5000
SOCKET_LOCATION_LIMIT=24
SOCKET_INCIDENT_LIMIT=8
SOCKET_SIGNAL_LIMIT=90
SOCKET_PTT_START_LIMIT=24

# Bounded periodic cleanup and storage monitoring.
RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=1000
STORAGE_MONITOR_INTERVAL_SECONDS=21600
STORAGE_WARNING_BYTES=5368709120
AUDIT_RETENTION_DAYS=365
INCIDENT_RETENTION_DAYS=365
LEGACY_INCIDENT_RETENTION_DAYS=180
LOCATION_HISTORY_RETENTION_DAYS=30
WELLBEING_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
SCAN_RETENTION_DAYS=180
ACTIVATION_TOKEN_RETENTION_DAYS=7
PUSH_SUBSCRIPTION_RETENTION_DAYS=180
